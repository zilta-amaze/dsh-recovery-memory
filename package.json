{
  "name": "dsh-recovery-memory",
  "version": "0.1.0",
  "description": "Recovery codes for DeepSeek Harness conversations: /recovery create snapshots the current memory into a 20-letter code, /recovery memory <code> restores it in another conversation.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "recovery",
    "context"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zilta-amaze/dsh-recovery-memory.git"
  },
  "homepage": "https://github.com/zilta-amaze/dsh-recovery-memory#readme",
  "bugs": {
    "url": "https://github.com/zilta-amaze/dsh-recovery-memory/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "assets/icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node test/recovery.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
